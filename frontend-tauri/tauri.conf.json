{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Careless",
  "version": "0.1.0",
  "identifier": "org.ggml.careless",
  "build": {
    "frontendDist": "web/build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Careless",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "visible": true,
        "focus": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.ico"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
